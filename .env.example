# Required: PocketBase admin account credentials
# Change these before deploying!
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-before-deploying

# Required: Base URL for your instance (used in ActivityPub federation and emails)
BASE_URL=https://your-domain.example.com

# Recommended: Encryption key for sensitive data at rest in PocketBase
# Generate with: openssl rand -base64 32
# WARNING: Leaving this empty means sensitive fields are stored unencrypted
PB_ENCRYPTION_KEY=

# Optional: GitHub repository owner (for Docker image pulls)
GITHUB_REPO_OWNER=grantstephens
